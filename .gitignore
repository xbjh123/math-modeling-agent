# Python / OS ignores
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# LaTeX temporary files
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fdb_latexmk
*.fls
*.xdv

# OS
.DS_Store
Thumbs.db

# math-modeling-agent runtime artifacts (运行流水线中间产物，不入库)
.modeling/
.modeling*/
# 具体的真题运行产物（每次跑题变化，不入库；含 _runN 变体）
benchmarks/problems/*/.modeling/
benchmarks/problems/*/.modeling*/
benchmarks/runs/**/.modeling/
benchmarks/runs/**/.modeling*/
# 具体 run 目录（含日期戳，如 20260828_xxx）为运行产物，整体忽略
benchmarks/runs/**/*_run*/
benchmarks/runs/**/20*/
# TikZ 编译生成的 PDF/PNG 为产物（.tex 源码入库即可）
templates/tikz/*.pdf
templates/tikz/*.png

# 根目录临时文档/测试记录（本地留存于各题 .modeling/）
/SESSION_EXPORT_*.md
/HITL_full_test_prompt_*.md
/RCA_*.md
